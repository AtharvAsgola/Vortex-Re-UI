{
    "manifest_version": 3,
    "name": "Vortex Re-UI",
    "version": "1.1.0",
    "description": "Vortex, now revamped!",
    "action": {
        "default_popup": "popup.html",
        "default_icon": "icon.png"
    },
    "icons": {
        "16": "icon.png",
        "48": "icon.png",
        "128": "icon.png"
    },
    "content_scripts": [
        {
            "matches": [
                "https://vortex.towerstats.com/*"
            ],
            "css": [
                "style.css"
            ],
            "js": [
                "content.js"
            ]
        }
    ],
    "permissions": [
        "storage",
        "activeTab"
    ]
}